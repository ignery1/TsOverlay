<Window x:Class="TS6_SpeakerOverlay.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TsOverlay"
        Width="300" Height="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#292B30"/>
            <Setter Property="Foreground" Value="#4FCD8E"/>
            <Setter Property="BorderThickness" Value="0"/>
            
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#232428" BorderBrush="#303238" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="TsOverlay" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
            <ProgressBar Width="200" Height="6" Margin="0,18,0,12" IsIndeterminate="True"/>
            <TextBlock x:Name="TxtStatus" Text="Carregando..." Foreground="#A3A6AA" HorizontalAlignment="Center" FontSize="13"/>
        </StackPanel>
    </Border>
</Window>