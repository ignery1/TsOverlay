<Window x:Class="TS6_SpeakerOverlay.Views.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TsOverlay - Ops, algo deu errado"
        Width="540" Height="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1E1F22">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Ops, o TsOverlay encontrou um erro"
                       FontSize="16" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="TxtSubtitle" Margin="0,4,0,0"
                       Text="Você pode continuar usando o app, mas esse erro pode se repetir."
                       Foreground="#AAAAAA" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="TxtDetails"
                 IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11"
                 Background="#111214" Foreground="#DDDDDD"
                 BorderThickness="1" BorderBrush="#333333"
                 Padding="8"/>

        <TextBlock Grid.Row="2" Margin="0,10,0,0"
                   Text="Deseja enviar esse erro para o desenvolvedor?"
                   Foreground="White"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnSend" Content="Enviar erro" Width="110" Height="30" Margin="0,0,8,0" Click="BtnSend_Click"/>
            <Button x:Name="BtnCopy" Content="Copiar" Width="90" Height="30" Margin="0,0,8,0" Click="BtnCopy_Click"/>
            <Button x:Name="BtnClose" Content="Fechar" Width="90" Height="30" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
