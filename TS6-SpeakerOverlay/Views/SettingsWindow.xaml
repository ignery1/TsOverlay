<Window x:Class="TS6_SpeakerOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TS6_SpeakerOverlay.Models"
        Title="{DynamicResource Lang_Settings_Title}" Height="680" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <!-- Font Base -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#E3E5E8"/>
        </Style>

        <!-- Switch Animado -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,15,0"/>
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="22" CornerRadius="11" Background="#4F545C">
                                <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.2"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#4FCD8E"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Moderno Suavizado -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Foreground" Value="#4FCD8E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="24">
                            <Border Height="6" CornerRadius="3" Background="#4F545C" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="#4FCD8E" Height="6" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" Background="White" VerticalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="{TemplateBinding Background}" Stroke="#4FCD8E" StrokeThickness="3"/>
                                                    <Ellipse Fill="#4FCD8E" Width="8" Height="8"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Minimalista -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E1F22"/>
            <Setter Property="BorderBrush" Value="#1E1F22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Grid.Column="2" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <Path Data="M0,0 L4,4 L8,0" Stroke="#B9BBBE" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <!-- AQUI ESTAVA O BUG: Esta propriedade define a cor escura do botão interno -->
                                <ToggleButton.Background>
                                    <SolidColorBrush Color="#1E1F22"/>
                                </ToggleButton.Background>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="12,0,30,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" />
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#292B30" BorderThickness="1" BorderBrush="#1E1F22" MaxHeight="180" MinWidth="{TemplateBinding ActualWidth}" CornerRadius="8" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.3"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#DCDDDE"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="4,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#32353B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4FCD8E"/>
                                <Setter Property="Foreground" Value="#122A1E"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de Preset -->
        <Style x:Key="PositionPresetButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1F22"/>
            <Setter Property="Foreground" Value="#B9BBBE"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#32353B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#232428" CornerRadius="16" BorderThickness="1" BorderBrush="#303238">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="12" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="75"/>
            </Grid.RowDefinitions>

            <!-- 1. Título e Topo -->
            <Grid Grid.Row="0" Background="#1E1F22" MouseDown="TitleBar_MouseDown" Cursor="SizeAll">
                <Border CornerRadius="16,16,0,0" Background="Transparent"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                    <Border Background="#4FCD8E" Width="4" Height="20" CornerRadius="2" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource Lang_Settings_Title}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Click="BtnClose_Click" Foreground="#A3A6AA" Background="Transparent" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand" Width="40" Height="40" Margin="0,0,15,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#ED4245"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- 2. Conteúdo em Cards -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" Margin="10,15,10,0">
                <StackPanel Margin="10,0">

                    <!-- Idioma -->
                    <Border Background="#292B30" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Lang_Language}" FontSize="11" FontWeight="Bold" Foreground="#8E9297" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource Lang_InterfaceLanguage}" Foreground="White" FontSize="14"/>
                            </StackPanel>
                            <ComboBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center" SelectedValuePath="Tag" SelectedValue="{Binding Config.Language}" SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem Content="Português - Brasil" Tag="pt-BR"/>
                                <ComboBoxItem Content="English" Tag="en-US"/>
                                <ComboBoxItem Content="中文 (简体)" Tag="zh-CN"/>
                                <ComboBoxItem Content="Français" Tag="fr-FR"/>
                                <ComboBoxItem Content="Русский" Tag="ru-RU"/>
                            </ComboBox>
                        </DockPanel>
                    </Border>

                    <!-- Aparência -->
                    <TextBlock Text="{DynamicResource Lang_Appearance}" Foreground="#8E9297" FontSize="11" FontWeight="Bold" Margin="5,0,0,8"/>
                    <Border Background="#292B30" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,25">
                                <TextBlock Text="{DynamicResource Lang_AvatarMode}" VerticalAlignment="Center" FontSize="14"/>
                                <ComboBox DockPanel.Dock="Right" Width="140" SelectedValuePath="Tag" SelectedValue="{Binding Config.AvatarDisplayMode}">
                                    <ComboBoxItem Content="{DynamicResource Lang_Mode_Avatar}">
                                        <ComboBoxItem.Tag>
                                            <models:AvatarMode>Avatar</models:AvatarMode>
                                        </ComboBoxItem.Tag>
                                    </ComboBoxItem>
                                    <ComboBoxItem Content="{DynamicResource Lang_Mode_Indicator}">
                                        <ComboBoxItem.Tag>
                                            <models:AvatarMode>Indicator</models:AvatarMode>
                                        </ComboBoxItem.Tag>
                                    </ComboBoxItem>
                                    <ComboBoxItem Content="{DynamicResource Lang_Mode_None}">
                                        <ComboBoxItem.Tag>
                                            <models:AvatarMode>None</models:AvatarMode>
                                        </ComboBoxItem.Tag>
                                    </ComboBoxItem>
                                </ComboBox>
                            </DockPanel>

                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource Lang_FontSize}" FontSize="13"/>
                                    <TextBlock Text="{Binding Config.FontSize, StringFormat=N0}" DockPanel.Dock="Right" Foreground="#4FCD8E" FontSize="13" FontWeight="Bold"/>
                                </DockPanel>
                                <Slider Minimum="10" Maximum="30" Value="{Binding Config.FontSize}" Style="{StaticResource ModernSlider}" Margin="0,0,0,20"/>

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource Lang_AvatarSize}" FontSize="13"/>
                                    <TextBlock Text="{Binding Config.AvatarSize, StringFormat=N0}" DockPanel.Dock="Right" Foreground="#4FCD8E" FontSize="13" FontWeight="Bold"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="50" Value="{Binding Config.AvatarSize}" Style="{StaticResource ModernSlider}" Margin="0,0,0,20"/>

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource Lang_Spacing}" FontSize="13"/>
                                    <TextBlock Text="{Binding Config.ItemSpacing, StringFormat=N0}" DockPanel.Dock="Right" Foreground="#4FCD8E" FontSize="13" FontWeight="Bold"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="20" Value="{Binding Config.ItemSpacing}" Style="{StaticResource ModernSlider}" Margin="0,0,0,20"/>

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource Lang_Opacity}" FontSize="13"/>
                                    <TextBlock Text="{Binding Config.BackgroundOpacity, StringFormat=P0}" DockPanel.Dock="Right" Foreground="#4FCD8E" FontSize="13" FontWeight="Bold"/>
                                </DockPanel>
                                <Slider Minimum="0.0" Maximum="1.0" Value="{Binding Config.BackgroundOpacity}" TickFrequency="0.05" IsSnapToTickEnabled="True" Style="{StaticResource ModernSlider}" Margin="0,0,0,20"/>

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource Lang_Scale}" FontSize="13"/>
                                    <TextBlock Text="{Binding Config.UiScale, StringFormat=N1}" DockPanel.Dock="Right" Foreground="#4FCD8E" FontSize="13" FontWeight="Bold"/>
                                </DockPanel>
                                <Slider Minimum="0.5" Maximum="2.5" Value="{Binding Config.UiScale}" TickFrequency="0.1" IsSnapToTickEnabled="True" Style="{StaticResource ModernSlider}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Posição -->
                    <TextBlock Text="{DynamicResource Lang_Posittion}" Foreground="#8E9297" FontSize="11" FontWeight="Bold" Margin="5,0,0,8"/>
                    <Border Background="#292B30" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Lang_SnapPosition}" Foreground="White" FontSize="13" Margin="0,0,0,15"/>
                            <UniformGrid Columns="2" Rows="3">
                                <Button Content="↖ Top Left" Command="{Binding ApplyPositionPresetCommand}" CommandParameter="TopLeft" Style="{StaticResource PositionPresetButton}"/>
                                <Button Content="↗ Top Right" Command="{Binding ApplyPositionPresetCommand}" CommandParameter="TopRight" Style="{StaticResource PositionPresetButton}"/>
                                <Button Content="← Center Left" Command="{Binding ApplyPositionPresetCommand}" CommandParameter="CenterLeft" Style="{StaticResource PositionPresetButton}"/>
                                <Button Content="→ Center Right" Command="{Binding ApplyPositionPresetCommand}" CommandParameter="CenterRight" Style="{StaticResource PositionPresetButton}"/>
                                <Button Content="↙ Bottom Left" Command="{Binding ApplyPositionPresetCommand}" CommandParameter="BottomLeft" Style="{StaticResource PositionPresetButton}"/>
                                <Button Content="↘ Bottom Right" Command="{Binding ApplyPositionPresetCommand}" CommandParameter="BottomRight" Style="{StaticResource PositionPresetButton}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Filtro de App -->
                    <TextBlock Text="{DynamicResource Lang_AppFilter}" Foreground="#8E9297" FontSize="11" FontWeight="Bold" Margin="5,0,0,8"/>
                    <Border Background="#292B30" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Config.OnlyShowForTargetProcess}" Margin="0,0,0,20">
                                <TextBlock Text="{DynamicResource Lang_AppToggle}" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                            </CheckBox>

                            <TextBlock Text="Selecione o jogo/app em execução:" Foreground="#8E9297" FontSize="12" Margin="0,0,0,8"/>
                            <DockPanel Margin="0,0,0,15">
                                <Button x:Name="BtnRefreshProcesses" DockPanel.Dock="Right"
                                        Content="⟳ Atualizar" Width="80" Height="34" Margin="10,0,0,0"
                                        Click="BtnRefreshProcesses_Click" ToolTip="Atualizar lista"
                                        Background="#1E1F22" Foreground="White" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <ComboBox x:Name="CmbRunningProcesses" ItemsSource="{Binding AvailableProcesses}"
                                          DisplayMemberPath="DisplayName" SelectionChanged="ProcessComboBox_SelectionChanged"/>
                            </DockPanel>

                            <TextBlock Text="Ou digite manualmente:" Foreground="#8E9297" FontSize="12" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Config.TargetProcessName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,8" Background="#1E1F22" Foreground="White"
                                     BorderBrush="Transparent" BorderThickness="0" FontSize="13"
                                     ToolTip="Nome do processo, ex: AIKABR.exe">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>
                    </Border>

                    <!-- Comportamento -->
                    <TextBlock Text="{DynamicResource Lang_Behavior}" Foreground="#8E9297" FontSize="11" FontWeight="Bold" Margin="5,0,0,8"/>
                    <Border Background="#292B30" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Config.EnableNotifications}" Margin="0,5">
                                <TextBlock Text="{DynamicResource Lang_EnableNotify}" Foreground="White" FontSize="13"/>
                            </CheckBox>
                            <Border Height="1" Background="#3A3B40" Margin="0,15"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Config.ShowOnlyTalking}" Margin="0,5">
                                <TextBlock Text="{DynamicResource Lang_ShowOnlyTalking}" Foreground="White" FontSize="13"/>
                            </CheckBox>
                            <Border Height="1" Background="#3A3B40" Margin="0,15"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Config.AutoStart}" Margin="0,5" Click="AutoStart_Click">
                                <TextBlock Text="(Auto-start with Windows)" Foreground="White" FontSize="13"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <Canvas Height="20"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer com Botões Suaves -->
            <Border Grid.Row="2" Background="#1E1F22" CornerRadius="0,0,16,16" Padding="30,0">
                <Grid>
                    <Button Content="{DynamicResource Lang_Reset}" Click="BtnReset_Click" Foreground="#ED4245" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Left"/>

                    <Button Content="{DynamicResource Lang_Save}" Click="BtnSave_Click" Background="#4FCD8E" Foreground="#122A1E" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Height="38" Width="120" HorizontalAlignment="Right">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="19"/>
                                <!-- Formato Pílula -->
                            </Style>
                        </Button.Resources>
                        <Button.Effect>
                            <DropShadowEffect Color="#4FCD8E" BlurRadius="12" Opacity="0.35" ShadowDepth="3"/>
                        </Button.Effect>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>